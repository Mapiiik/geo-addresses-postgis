# Postgres credentials. Used by the postgis service to initialise the database
# and (via compose substitution) injected into the importer + API connection
# strings. Change passwords before deploying anywhere reachable.
POSTGRES_USER=addresses
POSTGRES_PASSWORD=postgis
POSTGRES_DB=addresses

# --- API service ---
# Username + password for the read-only DB role created on first DB init.
# If you start postgis without API_DB_PASSWORD set, the role is NOT created —
# see README for how to create it manually on an existing DB.
API_DB_USER=addresses_api
API_DB_PASSWORD=apipassword

# Comma-separated allowlist of API keys checked against the X-API-Key request
# header. Leave empty for open access (dev only).
# API_KEYS=watcher-crm:abc123,watcher-nms:def456

# Port the API listens on (uvicorn) and Caddy proxies to. By default the
# port is NOT published to the host — external traffic goes through Caddy
# on 80/443 so HTTPS / auth aren't bypassed. Override only if 8000 clashes
# with something else on the compose network.
# API_PORT=8000

# --- HTTPS / Caddy reverse proxy ---
# Public-facing server name(s). Multiple space-separated names can be given
# (e.g. "example.com www.example.com") and Caddy will issue one SAN cert
# covering all of them. Two modes:
#   • localhost (default) → Caddy uses its internal CA (browsers will warn
#     unless you install Caddy's root cert). Great for dev.
#   • a real public hostname with DNS pointing here → Caddy auto-manages a
#     Let's Encrypt cert via ACME (requires ports 80 + 443 from public
#     internet). Production.
SERVER_NAME=localhost

# Override the host ports Caddy binds (defaults: 80 + 443). Useful when
# those ports are already taken on the host.
# IMPORTANT: Let's Encrypt requires host:80 + host:443 for ACME challenges,
# so changing these only works in dev with SERVER_NAME=localhost (internal
# CA). For a real public hostname leave them at 80/443.
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Importer scheduler (importer.scheduler — default container entrypoint) ---
# When during the month to run imports. Defaults shown.
# SCHEDULE_DAY=5
# SCHEDULE_HOUR=3
# SCHEDULE_MINUTE=0

# Set to 1 to run imports immediately on container start (use for first-time
# bootstrap). Leave at 0 in steady state so restarts don't re-import.
# RUN_ON_START=0

# Parallel COPY workers in the CZ importer (one CSV file per worker).
# RUIAN_WORKERS=4

# --- API service tuning (defaults shown) ---
# Connection pool size and default Cache-Control max-age in seconds.
# PG_POOL_MIN=2
# PG_POOL_MAX=10
# CACHE_MAX_AGE=3600

# --- Bare-metal alternative (no docker compose) ---
# When running the importers directly on the host, set PG_CONN_ADDRESSES
# (libpq format) explicitly instead of relying on POSTGRES_*:
# PG_CONN_ADDRESSES="host=localhost user=addresses dbname=addresses password=postgis"
